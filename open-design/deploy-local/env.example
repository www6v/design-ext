# ============================================================
# OpenDesign 本地部署 - 环境变量配置
# ============================================================
# 复制为 .env 并填入你的配置:
#   cp env.example .env
# ============================================================

# ---- 网络 ----

# Daemon 监听端口 (默认 7456)
OD_PORT=7456

# Web 前端端口 (开发模式, 默认 5173)
OD_WEB_PORT=5173

# 允许的浏览器来源 (逗号分隔, 用于 CORS)
# 例: http://localhost:5173,http://127.0.0.1:7456
OPEN_DESIGN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:7456

# ---- 认证 ----

# API Token (推荐设置, 生成方式: openssl rand -hex 32)
# 留空则跳过认证 (仅限本地可信环境)
OD_API_TOKEN=

# 是否禁用 API 认证 (设为 1 跳过 OD_API_TOKEN 检查)
# 仅在本地可信环境使用!
OPEN_DESIGN_DISABLE_API_AUTH=1

# ---- Node ----

# Node.js 堆内存上限 (MB)
NODE_OPTIONS=--max-old-space-size=2048

# ---- Agent CLI (可选) ----

# 如使用 BYOK (Bring Your Own Key) 运行时, 在此配置 API Key
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ---- 高级 (通常不需要修改) ----

# Web 构建输出模式:
#   (空)    = 静态导出 (daemon 直接服务, 默认)
#   server  = Next.js SSR 服务器模式
#   standalone = traced standalone 模式
# OD_WEB_OUTPUT_MODE=

# 工作区根目录覆盖 (通常自动检测, 无需设置)
# OD_WORKSPACE_ROOT=
